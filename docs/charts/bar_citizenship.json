{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "axis": {
      "domainColor": "#3A4A5C",
      "gridColor": "#1E2A3A",
      "tickColor": "#3A4A5C",
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "format": ",d"
    },
    "title": {
      "color": "#E8E0D0",
      "font": "Playfair Display",
      "fontSize": 14
    },
    "view": {
      "stroke": "transparent"
    },
    "axisQuantitative": {
      "format": ",d"
    }
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/citizenship.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.Gender === 'Total4'"
    },
    {
      "fold": [
        "New Zealand",
        "India",
        "United Kingdom",
        "Philippines",
        "Vietnam",
        "Nepal",
        "Iraq",
        "China",
        "Pakistan",
        "South Africa"
      ],
      "as": [
        "country",
        "value"
      ]
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "value"
    },
    {
      "filter": "isValid(datum.value)"
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#4A9EDB",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "country",
      "type": "ordinal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "format": ",d",
        "title": "New Citizens (2024–25)"
      }
    },
    "color": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "range": [
          "#1A5C8A",
          "#4A9EDB"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "country",
        "title": "Country"
      },
      {
        "field": "value",
        "title": "New Citizens",
        "format": ",d"
      }
    ]
  }
}
