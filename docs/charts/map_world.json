{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "axis": {
      "domainColor": "#3A4A5C",
      "gridColor": "#1E2A3A",
      "tickColor": "#3A4A5C",
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "format": ",d"
    },
    "title": {
      "color": "#E8E0D0",
      "font": "Playfair Display",
      "fontSize": 14
    },
    "view": {
      "stroke": "transparent"
    },
    "axisQuantitative": {
      "format": ",d"
    }
  },
  "width": "container",
  "height": 440,
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#1E2A3A",
        "stroke": "#2A3A4A",
        "strokeWidth": 0.5
      },
      "projection": {
        "type": "naturalEarth1"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/skilled_migration_map.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "id": "number",
                  "value": "number"
                }
              }
            },
            "key": "id",
            "fields": [
              "value",
              "country"
            ]
          }
        },
        {
          "filter": "isValid(datum.value)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#0D1117",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "legend": null
        }
      },
      "projection": {
        "type": "naturalEarth1"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#2EAD6F",
        "stroke": "#0D1117",
        "strokeWidth": 0.5
      },
      "projection": {
        "type": "naturalEarth1"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": {
            "param": "countryHover",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "transparent",
        "stroke": "#C9A84C",
        "strokeWidth": 2.5
      },
      "projection": {
        "type": "naturalEarth1"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/skilled_migration_map.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "id": "number",
                  "value": "number"
                }
              }
            },
            "key": "id",
            "fields": [
              "value",
              "country"
            ]
          }
        },
        {
          "filter": "datum.id === 36 || isValid(datum.value)"
        },
        {
          "calculate": "datum.id === 36 ? 'Australia' : datum.country",
          "as": "tooltip_country"
        },
        {
          "calculate": "datum.id === 36 ? 'Destination country' : format(datum.value, ',d') + ' skilled visas'",
          "as": "tooltip_detail"
        }
      ],
      "params": [
        {
          "name": "countryHover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "transparent",
        "stroke": "transparent",
        "strokeWidth": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "tooltip_country",
            "title": "Country"
          },
          {
            "field": "tooltip_detail",
            "title": "Detail"
          }
        ]
      },
      "projection": {
        "type": "naturalEarth1"
      }
    },
    {
      "mark": {
        "type": "text",
        "color": "#C9A84C",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "value": 79
        },
        "latitude": {
          "value": 22
        },
        "text": {
          "value": "India — largest source"
        }
      },
      "projection": {
        "type": "naturalEarth1"
      }
    }
  ]
}
