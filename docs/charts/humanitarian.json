{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "axis": {
      "domainColor": "#3A4A5C",
      "gridColor": "#1E2A3A",
      "tickColor": "#3A4A5C",
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "format": ",d"
    },
    "title": {
      "color": "#E8E0D0",
      "font": "Playfair Display",
      "fontSize": 14
    },
    "view": {
      "stroke": "transparent"
    },
    "axisQuantitative": {
      "format": ",d"
    }
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/humanitarian.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "Offshore resettlement total",
        "Onshore protection total"
      ],
      "as": [
        "type_raw",
        "value"
      ]
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "value"
    },
    {
      "calculate": "datum.type_raw === 'Offshore resettlement total' ? 'Offshore (Refugees)' : 'Onshore (Protection)'",
      "as": "type"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "axis": {
            "labelAngle": -40,
            "labelFontSize": 10
          },
          "title": "Financial Year"
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "format": ",d",
            "title": "Visas Granted"
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Offshore (Refugees)",
              "Onshore (Protection)"
            ],
            "range": [
              "#E05C3A",
              "#E8A87C"
            ]
          },
          "legend": {
            "title": "Type",
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "title": "Year"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "value",
            "title": "Visas",
            "format": ",d"
          }
        ]
      }
    }
  ]
}
