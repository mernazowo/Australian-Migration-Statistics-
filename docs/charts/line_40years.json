{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "axis": {
      "domainColor": "#3A4A5C",
      "gridColor": "#1E2A3A",
      "tickColor": "#3A4A5C",
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#8A9BAD",
      "titleColor": "#8A9BAD",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "format": ",d"
    },
    "title": {
      "color": "#E8E0D0",
      "font": "Playfair Display",
      "fontSize": 14
    },
    "view": {
      "stroke": "transparent"
    },
    "axisQuantitative": {
      "format": ",d"
    }
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/migration_program.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#C9A84C",
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Total",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              200000
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#C9A84C",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 45,
          "color": "#C9A84C"
        }
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Financial Year",
          "axis": {
            "labelAngle": -45,
            "labelFontSize": 10
          }
        },
        "y": {
          "field": "Total",
          "type": "quantitative",
          "title": "Total Visas Granted",
          "scale": {
            "domain": [
              0,
              200000
            ]
          },
          "axis": {
            "format": ",d"
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "title": "Financial Year"
          },
          {
            "field": "Total",
            "title": "Total Visas",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === '2022–23'"
        }
      ],
      "mark": {
        "type": "text",
        "color": "#E05C3A",
        "fontWeight": "bold",
        "fontSize": 11,
        "dy": -25
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Total",
          "type": "quantitative"
        },
        "text": {
          "value": "▲ Record intake"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === '2021–22'"
        }
      ],
      "mark": {
        "type": "text",
        "color": "#4A9EDB",
        "fontWeight": "bold",
        "fontSize": 11,
        "dy": 25
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Total",
          "type": "quantitative"
        },
        "text": {
          "value": "▼ COVID disruption"
        }
      }
    }
  ]
}
